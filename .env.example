# Sincronização. Opcional: sem estas variáveis vale o projeto padrão definido em src/lib/progress/sync.ts.
# Defina-as só para apontar o site para outro projeto Supabase.
# Supabase > Project Settings > API. A chave "anon"/"publishable" é pública por desenho:
# quem protege os dados são as políticas de supabase/schema.sql.
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
