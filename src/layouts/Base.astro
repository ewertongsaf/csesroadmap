---
import '../styles/global.css';
import ThemeToggle from '../components/islands/ThemeToggle.tsx';
import CommandK from '../components/islands/CommandK.tsx';
import StorageWarning from '../components/islands/StorageWarning.tsx';

interface Props {
  title: string;
  description?: string;
  /** Página "larga" (trilha, stats) vs. leitura (problema, módulo). */
  wide?: boolean;
}
const { title, description = 'Roadmap pessoal para resolver o CSES Problem Set inteiro.', wide = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/roadmap', label: 'Roadmap' },
  { href: '/stats', label: 'Estatísticas' },
  { href: '/checklist', label: 'Checklist' },
  { href: '/template', label: 'Template' },
  { href: '/config', label: 'Progresso' },
];
const active = (href: string) => path === href || path.startsWith(`${href}/`);
---
<!doctype html>
<html lang="pt-BR" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title === 'CSES Roadmap' ? title : `${title} · CSES Roadmap`}</title>
    <script is:inline>
      // Dark por padrão; só sai do dark se o usuário escolheu "light".
      try {
        if (localStorage.getItem('cses-roadmap:theme') === 'light') document.documentElement.classList.remove('dark');
      } catch {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-30 border-b border-line bg-bg/85 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight shrink-0">
          <span class="grid size-7 place-items-center rounded-md bg-accent text-accent-fg text-xs font-bold">CS</span>
          <span class="hidden sm:inline">CSES Roadmap</span>
        </a>
        <nav class="flex min-w-0 flex-1 items-center gap-1 overflow-x-auto text-sm">
          {nav.map((n) => (
            <a
              href={n.href}
              class:list={[
                'rounded-md px-2.5 py-1.5 whitespace-nowrap transition-colors',
                active(n.href) ? 'bg-surface-2 text-fg' : 'text-muted hover:text-fg',
              ]}
            >{n.label}</a>
          ))}
        </nav>
        <CommandK client:idle />
        <ThemeToggle client:load />
      </div>
    </header>
    <StorageWarning client:load />
    <main class:list={['mx-auto w-full flex-1 px-4 py-8', wide ? 'max-w-6xl' : 'max-w-3xl']}>
      <slot />
    </main>
    <footer class="border-t border-line py-6 text-center text-xs text-faint">
      Problemas do <a class="underline" href="https://cses.fi/problemset/">CSES Problem Set</a> (CC BY-NC-SA). Este site só linka os
      enunciados, não os copia. Teoria: <a class="underline" href="https://cses.fi/book/book.pdf">Competitive Programmer's Handbook</a>.
    </footer>
  </body>
</html>
