---
import '../styles/global.css';
import ThemeToggle from '../components/islands/ThemeToggle.tsx';
import CommandK from '../components/islands/CommandK.tsx';
import StorageWarning from '../components/islands/StorageWarning.tsx';
import LevelUp from '../components/islands/LevelUp.tsx';
import { Icon, type IconName } from '../components/ui.tsx';
import { xpTable } from '../lib/data.ts';

interface Props {
  title: string;
  description?: string;
  /** Página "larga" (trilha, stats) vs. leitura (problema, módulo). */
  wide?: boolean;
}
const { title, description = 'Roadmap pessoal para resolver o CSES Problem Set inteiro.', wide = false } = Astro.props;
const path = Astro.url.pathname;
const nav: { href: string; label: string; icon: IconName; mobile?: boolean; desktop?: boolean }[] = [
  { href: '/', label: 'Início', icon: 'home', mobile: true },
  { href: '/roadmap', label: 'Roadmap', icon: 'list', mobile: true, desktop: true },
  { href: '/jornada', label: 'Jornada', icon: 'map', mobile: true, desktop: true },
  { href: '/stats', label: 'Estatísticas', icon: 'chart', mobile: true, desktop: true },
  { href: '/checklist', label: 'Checklist', icon: 'check', desktop: true },
  { href: '/template', label: 'Template', icon: 'code', desktop: true },
  { href: '/config', label: 'Conta', icon: 'user', mobile: true, desktop: true },
];
// Páginas de milestone, problema, módulo e checkpoint pertencem ao roadmap.
const inRoadmap = /^\/(m|p|modulos|checkpoint)\//.test(path);
const active = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`) || (href === '/roadmap' && inRoadmap));
---
<!doctype html>
<html lang="pt-BR" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title === 'CSES Roadmap' ? title : `${title} · CSES Roadmap`}</title>
    <script is:inline>
      // Dark por padrão; só sai do dark se o usuário escolheu "light".
      try {
        if (localStorage.getItem('cses-roadmap:theme') === 'light') document.documentElement.classList.remove('dark');
      } catch {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:text-sm focus:font-semibold focus:text-accent-fg">Pular para o conteúdo</a>
    <header class="sticky top-0 z-30 border-b border-line bg-bg/80 backdrop-blur-md">
      <div class="mx-auto flex h-14 max-w-6xl items-center gap-2 px-4">
        <a href="/" class="mr-2 flex shrink-0 items-center gap-2.5 font-semibold tracking-tight">
          <img src="/favicon.svg" alt="" width="28" height="28" class="size-7" />
          <span>CSES Roadmap</span>
        </a>
        <nav aria-label="Principal" class="hidden min-w-0 flex-1 items-center gap-0.5 text-sm md:flex">
          {nav.filter((n) => n.desktop).map((n) => (
            <a
              href={n.href}
              aria-current={active(n.href) ? 'page' : undefined}
              class:list={[
                'rounded-lg px-2.5 py-1.5 whitespace-nowrap transition-colors',
                active(n.href) ? 'bg-surface-2 font-medium text-fg' : 'text-muted hover:bg-surface-2/60 hover:text-fg',
              ]}
            >{n.label}</a>
          ))}
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <LevelUp client:load table={xpTable} />
          <CommandK client:idle />
          <ThemeToggle client:load />
        </div>
      </div>
    </header>
    <StorageWarning client:load />
    <main id="conteudo" class:list={['page-enter mx-auto w-full flex-1 px-4 pt-8 pb-10 md:pb-12', wide ? 'max-w-6xl' : 'max-w-3xl']}>
      <slot />
    </main>
    <footer class="border-t border-line px-4 pt-6 pb-24 text-center text-xs text-faint md:pb-6">
      Problemas do <a class="underline" href="https://cses.fi/problemset/">CSES Problem Set</a> (CC BY-NC-SA). Este site só linka os
      enunciados, não os copia. Teoria: <a class="underline" href="https://cses.fi/book/book.pdf">Competitive Programmer's Handbook</a>.
    </footer>
    <nav aria-label="Principal" class="tabbar fixed inset-x-0 bottom-0 z-30 border-t border-line bg-bg/90 backdrop-blur-md md:hidden">
      <ul class="mx-auto grid max-w-md grid-cols-5">
        {nav.filter((n) => n.mobile).map((n) => (
          <li>
            <a
              href={n.href}
              aria-current={active(n.href) ? 'page' : undefined}
              class:list={['flex flex-col items-center gap-1 px-1 pt-2.5 pb-2 text-[11px]', active(n.href) ? 'font-semibold text-accent' : 'text-muted']}
            >
              <Icon name={n.icon} size={20} />
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </body>
</html>
