---
import Base from '../layouts/Base.astro';
import { HeroPortrait } from '../components/journey/Hero.tsx';
---
<Base title="Não encontrado">
  <div class="grid place-items-center py-16 text-center">
    <div class="grid size-32 place-items-center rounded-full bg-surface-2">
      <HeroPortrait gear={[]} className="h-24" />
    </div>
    <p class="mt-6 text-xs font-semibold uppercase tracking-[0.2em] text-accent">Erro 404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Este caminho não está no mapa</h1>
    <p class="mt-3 max-w-sm text-muted">A página não existe ou mudou de lugar. Volte para a trilha ou busque com Ctrl+K.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3 text-sm">
      <a href="/" class="rounded-lg bg-accent px-4 py-2.5 font-semibold text-accent-fg hover:opacity-90">Ir para o início</a>
      <a href="/roadmap" class="rounded-lg border border-line bg-surface px-4 py-2.5 hover:bg-surface-2">Abrir o roadmap</a>
    </div>
  </div>
</Base>
