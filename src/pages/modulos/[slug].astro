---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { milestones, moduleBySlug } from '../../lib/data.ts';
import { milestonePath } from '../../lib/trail.ts';
import { modules } from '../../../data/modules.ts';
import { moduleRefs } from '../../../data/module-refs.ts';

// Módulos com aula (MDX) e módulos só com referências (status 'planned').
export async function getStaticPaths() {
  const entries = await getCollection('modules');
  for (const entry of entries)
    if (!moduleBySlug.has(entry.id)) throw new Error(`content/modules/${entry.id}.mdx não está registrado em data/modules.ts`);
  const bySlug = new Map(entries.map((e) => [e.id, e]));
  return modules.map((m) => ({ params: { slug: m.slug }, props: { entry: bySlug.get(m.slug) ?? null, slug: m.slug } }));
}

const { entry, slug } = Astro.props as { entry: CollectionEntry<'modules'> | null; slug: string };
const ref = moduleBySlug.get(slug)!;
const usedBy = milestones.filter((m) => m.modules.includes(slug));
const Content = entry ? (await render(entry)).Content : null;
const refs = moduleRefs[slug] ?? [];
const title = entry?.data.title ?? ref.title;
const description =
  entry?.data.description ?? `${ref.title}: capítulo do CPH e referências externas verificadas para estudar antes dos problemas do milestone.`;
---
<Base title={title} description={description}>
  <p class="text-sm text-muted">
    Módulo ·{' '}
    {usedBy.map((m, i) => (
      <>
        {i > 0 && ', '}
        <a href={milestonePath(m.slug)} class="hover:text-fg">milestone {m.num}</a>
      </>
    ))}
  </p>
  <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
  {entry && <p class="mt-3 text-lg text-muted">{entry.data.description}</p>}
  <p class="mt-3 text-xs text-faint">
    {ref.cph.length > 0 && <>CPH (2018): seções {ref.cph.join(', ')}. </>}
    {ref.basedOn && <>Base: {ref.basedOn}.</>}
  </p>
  {Content ? (
    <article class="prose-cp mt-10">
      <Content />
    </article>
  ) : (
    <section class="mt-10">
      <p class="text-muted">
        Esta aula ainda não foi escrita. Estude pelas referências abaixo e depois volte para os problemas do milestone.
      </p>
      <h2 class="mt-8 text-lg font-semibold">Onde estudar</h2>
      <ul class="mt-3 space-y-2">
        {ref.cph.length > 0 && (
          <li class="rounded-xl border border-line bg-surface px-4 py-3">
            <a href="https://cses.fi/book/book.pdf" class="font-medium hover:text-accent">Competitive Programmer's Handbook (2018)</a>
            <span class="ml-2 text-sm text-muted">seções {ref.cph.join(', ')}</span>
          </li>
        )}
        {refs.map((r) => (
          <li class="rounded-xl border border-line bg-surface px-4 py-3">
            <a href={r.url} class="font-medium hover:text-accent">{r.label}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
