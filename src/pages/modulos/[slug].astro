---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { milestones, moduleBySlug } from '../../lib/data.ts';
import { milestonePath } from '../../lib/trail.ts';
import { Icon } from '../../components/ui.tsx';
import { modules } from '../../../data/modules.ts';
import { moduleRefs } from '../../../data/module-refs.ts';

// Módulos com aula (MDX) e módulos só com referências (status 'planned').
export async function getStaticPaths() {
  const entries = await getCollection('modules');
  for (const entry of entries)
    if (!moduleBySlug.has(entry.id)) throw new Error(`content/modules/${entry.id}.mdx não está registrado em data/modules.ts`);
  const bySlug = new Map(entries.map((e) => [e.id, e]));
  return modules.map((m) => ({ params: { slug: m.slug }, props: { entry: bySlug.get(m.slug) ?? null, slug: m.slug } }));
}

const { entry, slug } = Astro.props as { entry: CollectionEntry<'modules'> | null; slug: string };
const ref = moduleBySlug.get(slug)!;
const usedBy = milestones.filter((m) => m.modules.includes(slug));
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content ?? null;
const toc = (rendered?.headings ?? []).filter((h) => h.depth === 2);
const internal = (url: string) => url.startsWith('/');
const host = (url: string) => (internal(url) ? 'aula deste site' : new URL(url).hostname.replace(/^www\./, ''));
const refs = moduleRefs[slug] ?? [];
const title = entry?.data.title ?? ref.title;
const description =
  entry?.data.description ?? `${ref.title}: capítulo do CPH e referências externas verificadas para estudar antes dos problemas do milestone.`;
---
<Base title={title} description={description}>
  <p class="text-sm text-muted">
    Módulo ·{' '}
    {usedBy.map((m, i) => (
      <>
        {i > 0 && ', '}
        <a href={milestonePath(m.slug)} class="hover:text-fg">milestone {m.num}</a>
      </>
    ))}
  </p>
  <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
  {entry && <p class="mt-3 text-lg text-muted">{entry.data.description}</p>}
  <p class="mt-3 text-xs text-faint">
    {ref.cph.length > 0 && <>CPH (2018): seções {ref.cph.join(', ')}. </>}
    {ref.basedOn && <>Base: {ref.basedOn}.</>}
  </p>
  {Content ? (
    <>
      <div id="leitura" class="fixed inset-x-0 top-14 z-20 h-0.5 origin-left scale-x-0 bg-accent" aria-hidden="true"></div>
      {toc.length > 2 && (
        <details class="reveal group mt-8 rounded-xl border border-line bg-surface" open>
          <summary class="flex items-center justify-between px-5 py-3 text-sm font-medium">
            <span class="flex items-center gap-2"><Icon name="list" size={15} className="text-accent" /> Nesta aula</span>
            <span class="text-xs text-faint group-open:hidden">{toc.length} seções</span>
          </summary>
          <ol class="grid gap-x-6 gap-y-1.5 border-t border-line px-5 py-4 text-sm sm:grid-cols-2">
            {toc.map((h, i) => (
              <li class="flex gap-2">
                <span class="tabular-nums text-faint">{i + 1}.</span>
                <a href={`#${h.slug}`} class="text-muted hover:text-accent">{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )}
      <article class="prose-cp mt-10">
        <Content />
      </article>
      <script is:inline>
        (() => {
          const bar = document.getElementById('leitura');
          if (!bar) return;
          const update = () => {
            const max = document.documentElement.scrollHeight - innerHeight;
            bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
          };
          addEventListener('scroll', update, { passive: true });
          update();
        })();
      </script>
    </>
  ) : (
    <section class="mt-8">
      <p class="flex items-start gap-3 rounded-xl border border-dashed border-line px-4 py-3 text-sm text-muted">
        <Icon name="book" size={17} className="mt-0.5 text-accent" />
        <span>Esta aula ainda não foi escrita. Estude pelas referências abaixo, na ordem, e depois volte para os problemas do milestone.</span>
      </p>
      <h2 class="mt-8 text-lg font-semibold">Onde estudar</h2>
      <ol class="mt-3 space-y-2">
        {ref.cph.length > 0 && (
          <li>
            <a href="https://cses.fi/book/book.pdf" target="_blank" rel="noreferrer" class="lift flex items-center gap-4 rounded-xl border border-line bg-surface px-4 py-3.5">
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-accent/15 text-xs font-bold text-accent">CPH</span>
              <span class="min-w-0 flex-1">
                <span class="block font-medium">Competitive Programmer's Handbook (2018)</span>
                <span class="block text-sm text-muted">Seções {ref.cph.join(', ')} · a base teórica da trilha</span>
              </span>
              <Icon name="external" size={15} className="text-faint" />
            </a>
          </li>
        )}
        {refs.map((r) => (
          <li>
            <a href={r.url} target={internal(r.url) ? undefined : '_blank'} rel={internal(r.url) ? undefined : 'noreferrer'} class="lift flex items-center gap-4 rounded-xl border border-line bg-surface px-4 py-3.5">
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-surface-2 text-xs font-bold text-muted uppercase">{internal(r.url) ? 'cs' : host(r.url).slice(0, 2)}</span>
              <span class="min-w-0 flex-1">
                <span class="block font-medium">{r.label}</span>
                <span class="block truncate text-sm text-muted">{host(r.url)}</span>
              </span>
              <Icon name={internal(r.url) ? 'arrow' : 'external'} size={15} className="text-faint" />
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}
  <nav class="mt-12 flex flex-wrap gap-3 border-t border-line pt-6 text-sm">
    {usedBy.map((m) => (
      <a href={milestonePath(m.slug)} class="lift inline-flex items-center gap-2 rounded-xl border border-line bg-surface px-4 py-3">
        <span class="text-muted">Ir para os problemas do milestone {m.num}</span>
        <Icon name="arrow" size={15} className="text-accent" />
      </a>
    ))}
  </nav>
</Base>
