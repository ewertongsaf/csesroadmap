---
import Base from '../layouts/Base.astro';
import HomeDashboard from '../components/islands/HomeDashboard.tsx';
import { milestoneDetails, trailData } from '../lib/data.ts';
---
<Base title="CSES Roadmap" wide>
  <div class="mx-auto max-w-5xl">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Bora treinar.</h1>
    <p class="mt-1.5 text-sm text-muted">
      {trailData.problems.length} problemas do CSES em {trailData.milestones.length} milestones, na ordem dos pré-requisitos.
    </p>
    <div class="mt-6">
      <HomeDashboard client:load trail={trailData} details={milestoneDetails} />
    </div>
  </div>
</Base>
