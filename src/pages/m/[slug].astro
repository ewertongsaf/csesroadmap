---
import Base from '../../layouts/Base.astro';
import MilestoneProblems from '../../components/islands/MilestoneProblems.tsx';
import { milestones, moduleBySlug, problemById, trailData, type MilestoneInfo } from '../../lib/data.ts';
import { checkpointPath, milestonePath, modulePath } from '../../lib/trail.ts';
import { worldOf } from '../../lib/journey.ts';
import { Icon } from '../../components/ui.tsx';

export function getStaticPaths() {
  return milestones.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}

const { m } = Astro.props as { m: MilestoneInfo };
const trailMs = trailData.milestones[m.index];
const rows = m.problems.map((e) => ({ id: e.id, title: problemById.get(e.id)!.title, difficulty: e.difficulty }));
const reserved = m.checkpoint.reserved.map((e) => ({ id: e.id, title: problemById.get(e.id)!.title, difficulty: e.difficulty }));
const world = worldOf(m.phaseIndex);
const mods = m.modules.map((slug) => moduleBySlug.get(slug)!);
const prev = milestones[m.index - 1];
const next = milestones[m.index + 1];
const blindCount = m.checkpoint.reserved.length + m.checkpoint.review.length;
---
<Base title={`${m.num}. ${m.name}`}>
  <header
    class="-mx-4 -mt-8 mb-8 border-b border-line px-4 pt-8 pb-7 sm:mx-0 sm:mt-0 sm:rounded-2xl sm:border sm:px-7"
    style={`background-image: linear-gradient(120deg, color-mix(in oklab, ${world.color} 22%, transparent), transparent 65%)`}
  >
    <p class="flex flex-wrap items-center gap-x-2 text-sm text-muted">
      <a href="/roadmap" class="hover:text-fg">Roadmap</a>
      <span class="text-faint">/</span>
      <a href={`/roadmap#${m.slug}`} class="inline-flex items-center gap-1.5 hover:text-fg">
        <span class="size-2 rounded-full" style={`background:${world.color}`}></span>
        Fase {m.phaseIndex + 1} · {world.name}
      </a>
    </p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">
      <span class="tabular-nums text-faint">{m.num}.</span> {m.name}
    </h1>
    <p class="mt-3 text-lg text-muted">Ao final você sabe {m.goal}</p>
  </header>

  <section>
    <h2 class="flex items-center gap-2 text-lg font-semibold"><Icon name="book" size={18} className="text-accent" /> 1. Estude os módulos</h2>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
      {mods.map((mod) => (
        <li>
          <a href={modulePath(mod.slug)} class="lift flex h-full flex-col gap-2 rounded-xl border border-line bg-surface px-4 py-3.5">
            <span class="font-medium leading-snug">{mod.title}</span>
            <span class="mt-auto flex items-center justify-between gap-2 text-xs">
              <span class:list={['rounded-full px-2 py-0.5 font-medium', mod.status === 'written' ? 'bg-ok/15 text-ok' : 'bg-surface-2 text-muted']}>
                {mod.status === 'written' ? 'Aula completa' : 'Referências'}
              </span>
              <span class="text-faint">{mod.cph.length ? `CPH ${mod.cph.join(', ')}` : 'fora do CPH'}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <div class="mt-10">
    <h2 class="mb-3 flex items-center gap-2 text-lg font-semibold"><Icon name="bolt" size={18} className="text-accent" /> 2. Resolva na ordem</h2>
    <MilestoneProblems client:load milestone={trailMs} rows={rows} reserved={reserved} color={world.color} />
  </div>

  <section class="mt-10">
    <h2 class="mb-3 flex items-center gap-2 text-lg font-semibold"><Icon name="target" size={18} className="text-accent" /> 3. Feche com o Checkpoint Cego</h2>
    <a href={checkpointPath(m.slug)} class="lift flex items-center gap-4 rounded-xl border border-accent/40 bg-surface p-5">
      <span class="min-w-0 flex-1">
        <span class="block font-medium">{blindCount} problemas sem tema e sem tags</span>
        <span class="mt-1 block text-sm text-muted">
          {m.checkpoint.reserved.length > 0
            ? `${m.checkpoint.reserved.length} inédito(s), que só aparecem aqui, e ${m.checkpoint.review.length} de revisão.`
            : `Todos de revisão.`} Escreva qual técnica usaria antes de revelar.
        </span>
      </span>
      <Icon name="arrow" size={18} className="text-accent" />
    </a>
  </section>

  <nav class="mt-12 grid gap-3 text-sm sm:grid-cols-2">
    {prev ? (
      <a href={milestonePath(prev.slug)} class="lift min-w-0 rounded-xl border border-line bg-surface px-4 py-3">
        <span class="block text-xs text-faint">← Milestone {prev.num}</span>
        <span class="mt-0.5 block truncate text-muted">{prev.name}</span>
      </a>
    ) : <span />}
    {next && (
      <a href={milestonePath(next.slug)} class="lift min-w-0 rounded-xl border border-line bg-surface px-4 py-3 text-right">
        <span class="block text-xs text-faint">Milestone {next.num} →</span>
        <span class="mt-0.5 block truncate text-muted">{next.name}</span>
      </a>
    )}
  </nav>
</Base>
