---
import Base from '../layouts/Base.astro';
import RoadmapTrail from '../components/islands/RoadmapTrail.tsx';
import { milestoneDetails, trailData } from '../lib/data.ts';
---
<Base title="Roadmap" wide>
  <div class="mx-auto max-w-3xl">
    <h1 class="text-3xl font-semibold tracking-tight">Roadmap</h1>
    <p class="mt-2 text-muted">
      Uma trilha linear. Cada milestone libera seus módulos e termina num Checkpoint Cego, com problemas sem tema e sem tags,
      para treinar a parte que o CSES não treina: identificar a técnica.
      <a href="/jornada" class="text-accent underline underline-offset-4">Ver como mapa de mundos</a>.
    </p>
    <div class="mt-10">
      <RoadmapTrail client:load trail={trailData} details={milestoneDetails} />
    </div>
  </div>
</Base>
